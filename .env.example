# ============================================================
# AI Canvas 体験用デモ環境 — 環境変数サンプル（キー名のみ・実値は書かない）
#
# 実値は .env.local（ローカル）と Vercel の環境変数（本番）に設定する。
# .env* は .gitignore 済み。
#
# 【重要】OPENAI_API_KEY は PoC 測定用とは別のキーを使う。
#   同じキーを使うと、デモの利用が PoC の日次予算（$11.11）を食い、
#   「PoC にいくらかかったか」（A-4 の測定対象）が測れなくなる。
# ============================================================

# --- Supabase（プロジェクト: ai-canvas-demo / fxhwiyaqhluayrknhpvi） ---
NEXT_PUBLIC_SUPABASE_URL=https://fxhwiyaqhluayrknhpvi.supabase.co

# 公開してよいキー（ブラウザへ渡る）。ログインにだけ使う。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ★ 絶対に公開しない。RLS を迂回する。サーバー側の API ルートだけが使う。
#   Supabase ダッシュボード → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- 画像生成プロバイダ（どちらもデモ専用キー。PoC 用と分けること） ---
#
# ★ 生成は「まず OpenAI、拒否されたら Google」の順で試す。
#   PoC の実測（2026-08-16 日報）では OpenAI が 30/30 すべてポリシー拒否され、
#   Google は 35 件成功している。両方設定しないと拒否しか見えない可能性が高い。
#
# ★ GEMINI_API_KEY は課金を有効にしたキーを使うこと。
#   無料枠のままだと quota_not_enabled で弾かれる（PoC で実際に観測済み）。
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Slack 通知（任意。未設定でも生成は動く） ---
#
# 1 回の生成が終わるたびに、枚数・料金・成否・モデルを Slack へ送る。
#
# ★ 画像も署名付き URL も送らない。テキストの実績値だけを送る。
#   送るとチャンネルにいる全員が顔写真を開けてしまい、
#   招待制で守っている前提が崩れる。
#
# 取得手順：Slack → App を作成 → Incoming Webhooks を有効化
#           → Add New Webhook to Workspace → 通知先チャンネルを選ぶ
#           → 出てきた https://hooks.slack.com/services/… を貼る
#
# ★ hooks.slack.com 以外の URL は送信前に弾く（送信先の取り違え防止）。
SLACK_WEBHOOK_URL=

# --- 管理者（招待できる人）。カンマ区切り。 ---
#   ここに載っているアドレスだけが /admin を開ける。
ADMIN_EMAILS=fujimura@bekusamudayo1.com

# --- Google Drive への確定画像の保存（任意。未設定でも生成は動く） ---
#
# 機能仕様書 v2.1 F-06 / 4.7。選んだ 1 枚を共有ドライブへ保存する。
#
# ★ 保存先は「共有ドライブ」に限る。
#   サービスアカウントは自身のストレージ容量を持たないため、
#   マイドライブ配下のフォルダを指定すると storageQuotaExceeded で必ず失敗する
#   （仕様書 4.1.2 / 4.7.1）。設定モーダルの「接続を確認する」で事前に判別できる。
#
# 取得手順：
#   1. Google Cloud でプロジェクトを作り、Google Drive API を有効化
#   2. サービスアカウントを作成 → キー（JSON）を作成してダウンロード
#   3. JSON の client_email と private_key を下の 2 つへ設定
#   4. Google Drive で「共有ドライブ」を作り、その中に保存用フォルダを作る
#   5. 共有ドライブのメンバーに client_email を「コンテンツ管理者」以上で追加
#   6. 保存用フォルダを開いた URL の .../folders/<ここ> を ROOT_FOLDER_ID へ設定
GOOGLE_DRIVE_CLIENT_EMAIL=
# private_key は改行を含む。1 行で貼る場合は \n のままでよい（コード側で戻す）。
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Vercel Cron（Drive 未同期ぶんの自動再送）---
#
# ★ 未設定だと /api/cron/drive-resync は 503 を返して何もしない。
#   認証なしで叩ける状態にはしない（外部から Drive API を叩かせないため）。
#   任意の長い文字列でよい。例: openssl rand -hex 32
CRON_SECRET=
